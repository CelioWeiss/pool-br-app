
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isMaster() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'master';
    }

    function isFranchiseOwner(franchiseId) {
      // Checks if the user is the owner of the franchise document itself.
      return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/franchises/$(franchiseId)).data.ownerId;
    }

    function userBelongsToFranchise(franchiseId) {
      // Checks if the user's profile document says they belong to the franchise.
      return isSignedIn() && getUserData(request.auth.uid).franchiseId == franchiseId;
    }


    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Top-level user collection.
     * A user can read/write their own profile.
     * A master user can read/write any profile.
     * A franchise owner can read profiles of users in their franchise.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isMaster();
      allow get: if isFranchiseOwner(resource.data.franchiseId);
    }

    /**
     * @description Top-level franchise collection.
     * @path /franchises/{franchiseId}
     */
    match /franchises/{franchiseId} {
      // Any authenticated user can list franchises (e.g., for a selection screen)
      allow list: if isSignedIn();
      // Read, update, delete is restricted to the master user or the franchise owner.
      allow get, update, delete: if isMaster() || isFranchiseOwner(franchiseId);
      // Any authenticated user can create a franchise, as long as they set themselves as the owner.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      /**
       * @description Subcollections within a franchise.
       * Master user and the franchise owner have full access.
       * Users who belong to the franchise can read data.
       */
      match /{subcollection}/{docId} {
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
        allow list, get: if userBelongsToFranchise(franchiseId);
      }
    }
  }
}
