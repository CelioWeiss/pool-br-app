
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // Helper Functions
    // =============================
    function isMaster() {
      // This is a simple check, for a production app, consider using custom claims.
      return request.auth != null && request.auth.uid == "master-admin-01";
    }

    function isFranchiseOwner(franchiseId) {
      // Returns true if the user's UID matches the ownerId on the franchise document.
      return request.auth != null && get(/databases/$(database)/documents/franchises/$(franchiseId)).data.ownerId == request.auth.uid;
    }

    // =============================
    // Collection: users
    // =============================
    match /users/{userId} {
      // A user can read/write their own profile. The master admin can read/write any user profile.
      allow read, write: if isMaster() || (request.auth != null && request.auth.uid == userId);
    }

    // =============================
    // Collection: franchises and Subcollections
    // =============================
    match /franchises/{franchiseId} {
      // The master admin or the direct franchise owner can get or write the franchise document.
      allow get, write: if isMaster() || isFranchiseOwner(franchiseId);
      
      // Any signed-in user can list franchises (e.g., for a "find a franchise" map).
      allow list: if request.auth != null;

      // --- Subcollections: clients, technicians, appointments, etc. ---
      match /{subcollection}/{docId} {
        // The master admin or the franchise owner can manage all resources within their franchise.
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      }
    }
  }
}
