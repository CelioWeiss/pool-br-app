
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // Helper Functions
    // =============================
    function isMaster() {
      // This check assumes a 'users' collection where roles are stored.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null && userDoc.data.role == 'master';
    }

    function isFranchiseOwner(franchiseId) {
      let franchiseDoc = get(/databases/$(database)/documents/franchises/$(franchiseId));
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null &&
             franchiseDoc.exists == true &&
             franchiseDoc.data.ownerId == request.auth.uid &&
             userDoc.exists == true &&
             userDoc.data.role == 'owner';
    }
    
    function isUserInFranchise(franchiseId) {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        return request.auth != null &&
               userDoc.exists == true &&
               userDoc.data.franchiseId == franchiseId;
    }
    
    function getUserRole(userId) {
        let userDoc = get(/databases/$(database)/documents/users/$(userId));
        if (userDoc.exists == true) {
            return userDoc.data.role;
        }
        return null;
    }
    
    function isSameFranchiseAsUser(otherUserId) {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
        let otherUserDoc = get(/databases/$(database)/documents/users/$(otherUserId));
        return userDoc.exists == true &&
               otherUserDoc.exists == true &&
               userDoc.data.franchiseId == otherUserDoc.data.franchiseId;
    }

    // =============================
    // Collection: users
    // =============================
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isMaster() ||
        isSameFranchiseAsUser(userId)
      );
    }
    
    // =============================
    // Collection: universityVideos
    // =============================
    match /universityVideos/{videoId} {
      allow write: if isMaster();
      allow read: if request.auth != null;
    }

    // =============================
    // Collection: franchises and Subcollections
    // =============================
    match /franchises/{franchiseId} {
      
      allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      allow list: if request.auth != null;

      // --- Secure Subcollections ---
      
      match /technicians/{technicianId} {
        allow read, write, create, list: if isMaster() || isFranchiseOwner(franchiseId);
      }

      match /clients/{clientId} {
        allow read, write, create, list: if isMaster() || isFranchiseOwner(franchiseId) || (isUserInFranchise(franchiseId) && getUserRole(request.auth.uid) == 'client');
      }
      
      match /locations/{locationId} {
          // Owners can manage all locations in their franchise.
          // Technicians can read locations in their franchise to get schedule info.
          // Clients can read their own location data.
          allow create, write: if isMaster() || isFranchiseOwner(franchiseId);
          allow read, list: if isMaster() || isUserInFranchise(franchiseId);
      }
      
      match /appointments/{appointmentId} {
        // Master/Owner can do anything.
        // Technicians/Clients can read appointments in their own franchise.
        allow read, write, list, create: if isMaster() || isFranchiseOwner(franchiseId) || 
                                    (isUserInFranchise(franchiseId) && (getUserRole(request.auth.uid) == 'technician' || getUserRole(request.auth.uid) == 'client'));
      }

      match /serviceReports/{serviceReportId} {
        // Master/Owner can do anything.
        // Technicians/Clients can read reports in their own franchise.
        allow read, write, list, create: if isMaster() || isFranchiseOwner(franchiseId) || 
                                    (isUserInFranchise(franchiseId) && (getUserRole(request.auth.uid) == 'technician' || getUserRole(request.auth.uid) == 'client'));
      }
      
      match /quotes/{quoteId} {
        allow read, write, list, create: if isMaster() || isFranchiseOwner(franchiseId);
      }

      match /payments/{paymentId} {
        allow read, write, list, create: if isMaster() || isFranchiseOwner(franchiseId);
      }
    }
  }
}

    