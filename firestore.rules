
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // Helper Functions
    // =============================
    function isMaster() {
      // Retorna true se o usuário for um administrador mestre.
      // A verificação é simples, mas para um app em produção, considere usar custom claims.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    function isFranchiseOwner(franchiseId) {
      // Retorna true se o UID do usuário corresponder ao ownerId no documento da franquia.
      return request.auth != null && get(/databases/$(database)/documents/franchises/$(franchiseId)).data.ownerId == request.auth.uid;
    }

    // =============================
    // Collection: users
    // =============================
    match /users/{userId} {
      // Um usuário pode ler e escrever seu próprio perfil.
      // O administrador mestre pode ler e escrever qualquer perfil.
      allow read, write: if isMaster() || (request.auth != null && request.auth.uid == userId);
    }

    // =============================
    // Collection: franchises and Subcollections
    // =============================
    match /franchises/{franchiseId} {
      // Permite leitura e escrita no próprio documento da franquia para o mestre ou o proprietário.
      allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      
      // Qualquer usuário autenticado pode listar as franquias (para um mapa, por exemplo).
      allow list: if request.auth != null;

      // --- Subcollections: technicians ---
      match /technicians/{technicianId} {
        // O mestre ou o proprietário da franquia podem gerenciar técnicos.
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      }

      // --- Subcollections: clients ---
      match /clients/{clientId} {
        // O mestre ou o proprietário da franquia podem gerenciar clientes.
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      }
      
      // --- Outras Subcoleções ---
      // Esta regra se aplica a outras subcoleções como appointments, serviceReports, etc.
      match /{subcollection}/{docId} {
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      }
    }
  }
}
