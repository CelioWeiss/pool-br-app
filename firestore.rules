
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // Helper Functions
    // =============================

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the user's role is 'master'.
     * This relies on a document in the /users collection.
     */
    function isMaster() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    /**
     * Returns true if the user is the owner of the franchise specified by franchiseId.
     * This checks the ownerId field on the franchise document itself.
     */
    function isFranchiseOwner(franchiseId) {
      return isSignedIn() && get(/databases/$(database)/documents/franchises/$(franchiseId)).data.ownerId == request.auth.uid;
    }

    // =============================
    // Collection Rules
    // =============================

    /**
     * @description Top-level user collection.
     * A user can read/write their own profile.
     * The master user can read/write any user profile.
     */
    match /users/{userId} {
      allow read, write: if isMaster() || (isSignedIn() && request.auth.uid == userId);
    }

    /**
     * @description Franchise documents and their subcollections.
     * Access is granted to the master user or the owner of the specific franchise.
     */
    match /franchises/{franchiseId} {
      // Allow read/write access on the franchise document itself
      allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      allow list: if isSignedIn(); // Any signed in user can list franchises

      /**
       * @description Rules for all subcollections within a franchise.
       * This single rule applies to clients, technicians, appointments, etc.
       * Access is granted if the user is the master admin or the owner of the parent franchise.
       */
      match /{subcollection}/{docId} {
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      }
    }
  }
}
