
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // Helper Functions
    // =============================
    function isMaster() {
      // This is a simple check, for a production app, consider using custom claims.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    function isFranchiseOwner(franchiseId) {
      // Returns true if the user's UID matches the ownerId on the franchise document.
      // It also checks for document existence to prevent errors on get().data
      let franchiseDocExists = exists(/databases/$(database)/documents/franchises/$(franchiseId));
      return request.auth != null &&
        franchiseDocExists &&
        get(/databases/$(database)/documents/franchises/$(franchiseId)).data.ownerId == request.auth.uid;
    }

    // =============================
    // Collection: users
    // =============================
    match /users/{userId} {
      // A user can read/write their own profile. The master admin can read/write any user profile.
      allow read, write: if isMaster() || (request.auth != null && request.auth.uid == userId);
    }

    // =============================
    // Collection: franchises and Subcollections
    // =============================
    match /franchises/{franchiseId} {
      
      // Allow master and the specific franchise owner to read/write the franchise document.
      allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      
      // Any signed-in user can list franchises (e.g., for a "find a franchise" map).
      allow list: if request.auth != null;

      // --- Secure Subcollections ---
      match /technicians/{technicianId} {
        // Allow master or the franchise owner to perform all actions on technicians.
        allow read, write, list: if isMaster() || isFranchiseOwner(franchiseId);
      }

      match /clients/{clientId} {
         // Allow master or the franchise owner to perform all actions on clients.
        allow read, write, list: if isMaster() || isFranchiseOwner(franchiseId);
      }
      
      match /appointments/{appointmentId} {
         // Allow master or the franchise owner to perform all actions on appointments.
        allow read, write, list: if isMaster() || isFranchiseOwner(franchiseId);
      }

      match /serviceReports/{serviceReportId} {
         // Allow master or the franchise owner to perform all actions on service reports.
        allow read, write, list: if isMaster() || isFranchiseOwner(franchiseId);
      }
    }
  }
}
