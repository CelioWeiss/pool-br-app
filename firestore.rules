/**
 * # Firestore Security Rules
 *
 * ## Core Philosophy
 * This ruleset enforces a franchise-centric, role-based access control model.
 * A user's access is primarily determined by their membership within a specific
 * franchise and their role ('owner', 'technician', etc.) within that franchise.
 * Data is strictly segregated by franchise, preventing any cross-franchise data access.
 *
 * ## Data Structure
 * The data is organized hierarchically. All operational data like users, clients,
 * and appointments is nested within a top-level `/franchises/{franchiseId}` collection.
 * This structure provides natural, path-based security boundaries for each franchise.
 *
 * ## Key Security Decisions
 * - **Franchise Isolation**: All rules are scoped to a specific franchise ID from the
 *   request path. This is the primary security boundary.
 * - **Database-Based Access Control (DBAC)**: A user's permissions are derived from
 *   the `role` field in their document located at `/franchises/{franchiseId}/users/{userId}`.
 *   This requires a `get()` call to the user's own document to determine their permissions for
 *   other resources within the franchise.
 * - **Franchise Creation**: To resolve the circular dependency of needing to be a "master user"
 *   within a franchise to create a new one, this ruleset simplifies franchise creation.
 *   Any authenticated user can create a new franchise, and they are automatically
 *   assigned as the `ownerId` of that new franchise.
 * - **Default Read Access**: Within a franchise, all authenticated members of that
 *   franchise are granted read access (`get`, `list`) to franchise-level data
 *   (clients, appointments, etc.). Write access is more restrictive and typically limited
 *   to 'owner' or 'technician' roles.
 *
 * ## Denormalization for Authorization
 * To create simpler and more performant rules, the `franchiseId` is denormalized
 * (copied) onto every document within a franchise's subcollections (e.g., clients,
 * appointments). This allows rules to validate relational integrity on write operations
 * without performing costly extra reads. For example, a rule can verify that a new
 * client document has the correct `franchiseId` property matching its location in the
 * database.
 *
 * ## Structural Segregation
 * By nesting entity types (clients, technicians, etc.) in their own dedicated
 * subcollections under a franchise, we ensure that all documents within a given
 * path share the same fundamental security context. This eliminates the need for
 * complex, query-based rules and leads to a more secure and performant system.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the requesting user's UID matches the provided userId.
     * This is the fundamental check for document ownership.
     * @param userId The user ID to check against the authenticated user.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Retrieves the user's profile document data from within a specific franchise.
     * This is the core of the role-based access control system.
     * @param franchiseId The franchise context for the user lookup.
     */
    function getUserData(franchiseId) {
      return get(/databases/$(database)/documents/franchises/$(franchiseId)/users/$(request.auth.uid)).data;
    }

    /**
     * Checks if a user is a registered member of a given franchise.
     * @param franchiseId The franchise to check membership in.
     */
    function isFranchiseMember(franchiseId) {
      return isSignedIn() && exists(/databases/$(database)/documents/franchises/$(franchiseId)/users/$(request.auth.uid));
    }

    /**
     * Retrieves the role of the current user within a specific franchise.
     * @param franchiseId The franchise context to get the role from.
     */
    function getUserRole(franchiseId) {
      return getUserData(franchiseId).role;
    }

    /**
     * Checks if the user has the 'owner' role within the franchise.
     * @param franchiseId The franchise context to check the role in.
     */
    function isFranchiseOwner(franchiseId) {
      return isFranchiseMember(franchiseId) && getUserRole(franchiseId) == 'owner';
    }

    /**
     * Checks if the user is considered 'staff' (owner or technician).
     * This is used to grant write permissions on franchise-level data.
     * @param franchiseId The franchise context to check the role in.
     */
    function isFranchiseStaff(franchiseId) {
      let role = getUserRole(franchiseId);
      return isFranchiseMember(franchiseId) && (role == 'owner' || role == 'technician');
    }

    /**
     * Validates that the incoming document data has a franchiseId that
     * matches the franchiseId from the document path.
     * @param franchiseId The franchiseId from the path to validate against.
     */
    function hasCorrectFranchiseIdOnCreate(franchiseId) {
      return request.resource.data.franchiseId == franchiseId;
    }

    /**
     * Validates that the franchiseId field is not being changed during an update.
     */
    function hasImmutableFranchiseId() {
      return request.resource.data.franchiseId == resource.data.franchiseId;
    }

    /**
     * Validates that the incoming document's id matches the documentId from the path.
     * Used for user profiles to ensure data integrity.
     * @param docId The ID from the path to validate against.
     */
    function hasCorrectIdOnCreate(docId) {
      return request.resource.data.id == docId;
    }

    /**
     * Validates that the internal id field is not being changed during an update.
     */
    function hasImmutableId() {
      return request.resource.data.id == resource.data.id;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Controls access to Franchise documents.
     * Franchise information is public to read, but creating, updating, and
     * deleting a franchise is restricted.
     * @path /franchises/{franchiseId}
     * @allow (get) Any user, signed in or not, can read a franchise document.
     * @deny (create) A user tries to create a franchise but doesn't set themselves as the owner.
     * @principle Public read with owner-only writes. Any signed-in user can create a franchise and become its owner.
     */
    match /franchises/{franchiseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource != null && isOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to User documents within a franchise.
     * Users can manage their own profile. Franchise owners can manage any user profile in their franchise.
     * @path /franchises/{franchiseId}/users/{userId}
     * @allow (update) An authenticated user updates their own profile document.
     * @deny (list) A regular user (technician/client) tries to list all users in the franchise.
     * @principle Restricts access to a user's own data tree, with elevated privileges for franchise owners.
     */
    match /franchises/{franchiseId}/users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isFranchiseOwner(franchiseId));
      allow list: if isSignedIn() && isFranchiseOwner(franchiseId);
      allow create: if isOwner(userId) && hasCorrectFranchiseIdOnCreate(franchiseId) && hasCorrectIdOnCreate(userId);
      allow update: if isSignedIn() && resource != null && isOwner(userId) && hasImmutableFranchiseId() && hasImmutableId();
      allow delete: if isSignedIn() && resource != null && isFranchiseOwner(franchiseId);
    }

    /**
     * @description Controls access to Client documents within a franchise.
     * Any member of the franchise can read client data, but only staff (owners, technicians) can modify it.
     * @path /franchises/{franchiseId}/clients/{clientId}
     * @allow (create) A franchise owner or technician creates a new client document.
     * @deny (update) A user from another franchise attempts to update a client.
     * @principle Shared access for reads, role-based access for writes, within a franchise boundary.
     */
    match /franchises/{franchiseId}/clients/{clientId} {
      allow get, list: if isFranchiseMember(franchiseId);
      allow create: if isFranchiseStaff(franchiseId) && hasCorrectFranchiseIdOnCreate(franchiseId);
      allow update, delete: if isSignedIn() && resource != null && isFranchiseStaff(franchiseId) && hasImmutableFranchiseId();
    }

    /**
     * @description Controls access to Technician documents within a franchise.
     * Any member of the franchise can read technician data, but only staff can modify it.
     * @path /franchises/{franchiseId}/technicians/{technicianId}
     * @allow (get) A client user in the franchise reads a technician's profile.
     * @deny (create) A client user tries to create a new technician document.
     * @principle Shared access for reads, role-based access for writes, within a franchise boundary.
     */
    match /franchises/{franchiseId}/technicians/{technicianId} {
      allow get, list: if isFranchiseMember(franchiseId);
      allow create: if isFranchiseStaff(franchiseId) && hasCorrectFranchiseIdOnCreate(franchiseId);
      allow update, delete: if isSignedIn() && resource != null && isFranchiseStaff(franchiseId) && hasImmutableFranchiseId();
    }

    /**
     * @description Controls access to Appointment documents within a franchise.
     * Any member of the franchise can read appointment data, but only staff can modify it.
     * @path /franchises/{franchiseId}/appointments/{appointmentId}
     * @allow (list) Any authenticated member of the franchise lists all appointments.
     * @deny (delete) A user who is not a member of the franchise tries to delete an appointment.
     * @principle Shared access for reads, role-based access for writes, within a franchise boundary.
     */
    match /franchises/{franchiseId}/appointments/{appointmentId} {
      allow get, list: if isFranchiseMember(franchiseId);
      allow create: if isFranchiseStaff(franchiseId) && hasCorrectFranchiseIdOnCreate(franchiseId);
      allow update, delete: if isSignedIn() && resource != null && isFranchiseStaff(franchiseId) && hasImmutableFranchiseId();
    }

    /**
     * @description Controls access to Service Report documents within a franchise.
     * Any member of the franchise can read reports, but only staff can modify them.
     * @path /franchises/{franchiseId}/serviceReports/{serviceReportId}
     * @allow (create) A technician creates a new service report for an appointment.
     * @deny (update) A client user tries to modify an existing service report.
     * @principle Shared access for reads, role-based access for writes, within a franchise boundary.
     */
    match /franchises/{franchiseId}/serviceReports/{serviceReportId} {
      allow get, list: if isFranchiseMember(franchiseId);
      allow create: if isFranchiseStaff(franchiseId) && hasCorrectFranchiseIdOnCreate(franchiseId);
      allow update, delete: if isSignedIn() && resource != null && isFranchiseStaff(franchiseId) && hasImmutableFranchiseId();
    }

  }
}