
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================
    // Helper Functions
    // =============================
    function isMaster() {
      // For this app, the master user is anyone with the role 'master' in their user document.
      // NOTE: This assumes that only a trusted admin can set this role.
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    function isFranchiseOwner(franchiseId) {
      // User is the owner if their UID matches the ownerId on the franchise document.
      return request.auth != null && get(/databases/$(database)/documents/franchises/$(franchiseId)).data.ownerId == request.auth.uid;
    }

    // =============================
    // Collection: users
    // =============================
    match /users/{userId} {
      // A user can read/write their own profile.
      // The master user can read/write any user profile.
      allow read, write: if isMaster() || (request.auth != null && request.auth.uid == userId);
    }

    // =============================
    // Collection: franchises and Subcollections
    // =============================
    match /franchises/{franchiseId} {
      // Allow read/write access on the franchise document itself to the master user or the owner.
      allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      
      // Any signed-in user can list franchises, e.g. for a global map view.
      // This is safe because it doesn't grant access to subcollections.
      allow list: if request.auth != null;

      // --- Subcollections ---
      // This single rule applies to clients, technicians, appointments, etc.
      // Access is granted if the user is the master admin or the owner of the parent franchise.
      match /{subcollection}/{docId} {
        allow read, write: if isMaster() || isFranchiseOwner(franchiseId);
      }
    }
  }
}

    